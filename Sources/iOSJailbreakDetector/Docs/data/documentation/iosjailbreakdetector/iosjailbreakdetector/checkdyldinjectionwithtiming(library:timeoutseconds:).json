to wait for "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":". Defaults to 0.1s."}]}]}]},{"kind":"content","content":[{"text":"Return Value","level":2,"anchor":"return-value","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult"},{"type":"text","text":" indicating the detection status:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".clean(loadTime:library:)"},{"type":"text","text":": No injection detected"}]}]},{"content":[{"inlineContent":[{"code":".suspicious(delay:library:)","type":"codeVoice"},{"text":": Suspicious delay during load attempt (possible hooking)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}]}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,","type":"text"},{"text":" ","type":"text"},{"text":"and provides detailed detection results for security logging.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Uses ","type":"text"},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"text":" to evade detection.","type":"text"}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"type":"codeListing","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"],"syntax":"swift"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection.","type":"text"}]}]}]}],"sections":[],"identifier":{"url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"iOSJailbreakDetector"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","kind":"typeIdentifier","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResult