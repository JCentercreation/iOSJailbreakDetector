:" "},{"type":"text","text":"It uses "},{"type":"codeVoice","code":"CFAbsoluteTimeGetCurrent()"},{"type":"text","text":" for precise timing without extra dependencies."}]}],"style":"important"}],"kind":"content"}],"metadata":{"title":"checkSuspiciousFilesWithTiming(path:suspiciousJailbreakHookTimingInSeconds:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"checkSuspiciousFilesWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"path","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"suspiciousJailbreakHookTimingInSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:20iOSJailbreakDetector31SuspiciousFilesWithTimingResultO","text":"SuspiciousFilesWithTimingResult","kind":"typeIdentifier"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:20iOSJailbreakDetectorAAC30checkSuspiciousFilesWithTiming4path023suspiciousJailbreakHookG9InSecondsAA0defG6ResultOSS_SdtF","role":"symbol","modules":[{"name":"iOSJailbreakDetector"}]},"kind":"symbol","variants":[{"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checksuspiciousfileswithtiming(path:suspiciousjailbreakhooktiminginseconds:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkSuspiciousFilesWithTiming(path:suspiciousJailbreakHookTimingInSeconds:)"},"abstract":[{"type":"text","text":"Checks for jailbreak by detecting suspicious system