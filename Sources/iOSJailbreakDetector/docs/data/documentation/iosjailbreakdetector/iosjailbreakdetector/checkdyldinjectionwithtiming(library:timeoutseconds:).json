"typeIdentifier","text":"Double"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"typeIdentifier","text":"DYLDInjectionResult"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"library","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the dynamic library to check (e.g., "},{"type":"codeVoice","code":"\"MobileSubstrate.dylib\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"libhooker.dylib\""},{"type":"text","text":")."}]}]},{"name":"timeoutSeconds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum time (in seconds) to wait for "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":". Defaults to 0.1s."}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult"},{"type":"text","text":" indicating the detection status:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".clean(loadTime:library:)","type":"codeVoice"},{"text":": No injection detected","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".suspicious(delay:library:)","type":"codeVoice"},{"text":": Suspicious delay during load attempt (possible hooking)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".injected(handle:loadTime:library:)","type":"codeVoice"},{"text":": Confirmed injection - library successfully loaded","type":"text"}],"type":"paragraph"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"type":"text","text":" flag to check if library is already loaded without forcing a new load."},{"type":"text","text":" "},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" to evade detection."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Usage example:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}]}]}]}],"abstract":[{"type":"text","text":"Detects DYLD injection by checkin