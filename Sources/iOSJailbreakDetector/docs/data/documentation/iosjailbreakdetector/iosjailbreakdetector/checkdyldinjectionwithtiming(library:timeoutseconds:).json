{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process.","type":"text"}],"variants":[{"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkDYLDInjectionWithTiming"},{"kind":"text","text":"("},{"kind":"externalParam","text":"library"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"library","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the dynamic library to check (e.g., "},{"code":"\"MobileSubstrate.dylib\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"libhooker.dylib\"","type":"codeVoice"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Maximum time (in seconds) to wait for ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":". Defaults to 0.1s."}]}],"name":"timeoutSeconds"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","type":"reference","isActive":true},{"type":"text","text":" indicating the detection status:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".clean(loadTime:library:)","type":"codeVoice"},{"text":": No injection detected","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"text":": Suspicious delay during load attempt (possible hooking)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"text":": Confirmed injection - library successfully loaded","type":"text"}]}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,","type":"text"},{"type":"text","text":" "},{"text":"and provides detailed detection results for security logging.","type":"text"}]},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" to evade detection."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"syntax":"swift","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"],"type":"codeListing"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}]}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","role":"symbol","roleHeading":"Instance Method","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","modules":[{"name":"iOSJailbreakDetector"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkDYLDInjectionWithTiming"},{"kind":"text","text":"("},{"kind":"externalParam","text":"library"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","text":"DYLDInjectionResult"}],"symbolKind":"method"},"sections":[],"references":{"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector":{"url":"\/documentation\/iosjailbreakdetector","abstract":[],"kind":"symbol","role":"collection","title":"iOSJailbreakDetector","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","type":"topic"},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector/checkDYLDInjectionWithTiming(library:timeoutSeconds:)":{"type":"topic","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"library"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","kind":"typeIdentifier","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO"}],"url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"kind":"symbol","role":"symbol"},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/DYLDInjectionResult":{"role":"symbol","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"DYLDInjectionResult"}],"title":"DYLDInjectionResult","kind":"symbol","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","url":"\/documentation\/iosjailbreakdetector\/dyldinjectionresult","navigatorTitle":[{"text":"DYLDInjectionResult","kind":"identifier"}],"abstract":[{"type":"text","text":"Detailed result from DYLD injection detection with timing analysis."}]},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector":{"navigatorTitle":[{"kind":"identifier","text":"iOSJailbreakDetector"}],"title":"iOSJailbreakDetector","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"iOSJailbreakDetector"}],"url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector","type":"topic","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector","abstract":[],"kind":"symbol","role":"symbol"}}}