{"identifier":{"url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)"]}],"metadata":{"title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkDYLDInjectionWithTiming"},{"kind":"text","text":"("},{"kind":"externalParam","text":"library"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","kind":"typeIdentifier"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","role":"symbol","modules":[{"name":"iOSJailbreakDetector"}]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"library"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"text":"timeoutSeconds","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"typeIdentifier","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","text":"DYLDInjectionResult"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the dynamic library to check (e.g., "},{"type":"codeVoice","code":"\"MobileSubstrate.dylib\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"libhooker.dylib\""},{"type":"text","text":")."}]}],"name":"library"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum time (in seconds) to wait for "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":". Defaults to 0.1s."}]}],"name":"timeoutSeconds"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult"},{"type":"text","text":" indicating the detection status:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".clean(loadTime:library:)"},{"type":"text","text":": No injection detected"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"type":"text","text":": Suspicious delay during load attempt (possible hooking)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"type":"text","text":" flag to check if library is already loaded without forcing a new load."},{"type":"text","text":" "},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" to evade detection."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}],"type":"paragraph"}]}],"kind":"content"}],"references":{"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector":{"title":"iOSJailbreakDetector","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"iOSJailbreakDetector","kind":"identifier"}],"navigatorTitle":[{"text":"iOSJailbreakDetector","kind":"identifier"}],"kind":"symbol","abstract":[],"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector","type":"topic","role":"symbol","url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector"},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/DYLDInjectionResult":{"type":"topic","title":"DYLDInjectionResult","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DYLDInjectionResult","kind":"identifier"}],"navigatorTitle":[{"text":"DYLDInjectionResult","kind":"identifier"}],"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","url":"\/documentation\/iosjailbreakdetector\/dyldinjectionresult","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"Detailed result from DYLD injection detection with timing analysis."}]},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector":{"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","type":"topic","url":"\/documentation\/iosjailbreakdetector","role":"collection","kind":"symbol","title":"iOSJailbreakDetector","abstract":[]},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector/checkDYLDInjectionWithTiming(library:timeoutSeconds:)":{"abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","type":"topic","kind":"symbol","url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)","role":"symbol","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","text":"DYLDInjectionResult","kind":"typeIdentifier"}]}}}