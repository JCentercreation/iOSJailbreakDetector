/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}]}],"style":"important","type":"aside","name":"Important"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","role":"symbol","modules":[{"name":"iOSJailbreakDetector"}],"title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","symbolKind":"method","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"