{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","kind":"typeIdentifier","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult"}],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Name of the dynamic library to check (e.g., ","type":"text"},{"type":"codeVoice","code":"\"MobileSubstrate.dylib\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"libhooker.dylib\""},{"text":").","type":"text"}]}],"name":"library"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Maximum time (in seconds) to wait for ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":". Defaults to 0.1s.","type":"text"}]}],"name":"timeoutSeconds"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","type":"heading","anchor":"return-value"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","type":"reference","isActive":true},{"text":" indicating the detection status:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".clean(loadTime:library:)","type":"codeVoice"},{"text":": No injection detected","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".suspicious(delay:library:)","type":"codeVoice"},{"text":": Suspicious delay during load attempt (possible hooking)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".injected(handle:loadTime:library:)","type":"codeVoice"},{"text":": Confirmed injection - library successfully loaded","type":"text"}]}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,","type":"text"},{"text":" ","type":"text"},{"text":"and provides detailed detection results for security logging.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Uses ","type":"text"},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"text":" ","type":"text"},{"text":"Requires ","type":"text"},{"type":"codeVoice","code":"import Darwin"},{"text":". Modern jailbreaks may hook ","type":"text"},{"type":"codeVoice","code":"dlopen"},{"text":" to evade detection.","type":"text"}]}]},{"inlineContent":[{"text":"Usage example:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection.","type":"text"}]}]}]}],"abstract":[{"text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"iOSJailbreakDetector"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","roleHeading":"Instance Method","symbolKind":"method"},"sections":[],"identifier":{"url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDIn