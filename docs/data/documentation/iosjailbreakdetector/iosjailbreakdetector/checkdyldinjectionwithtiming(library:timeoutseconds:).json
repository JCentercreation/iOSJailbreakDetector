{"kind":"symbol","sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"checkDYLDInjectionWithTiming"},{"kind":"text","text":"("},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":"s:Sd"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","kind":"typeIdentifier","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO"}],"modules":[{"name":"iOSJailbreakDetector"}],"externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","symbolKind":"method","role":"symbol","roleHeading":"Instance Method"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"timeoutSeconds"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Double","preciseIdentifier":"s:Sd"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the dynamic library to check (e.g., "},{"code":"\"MobileSubstrate.dylib\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"libhooker.dylib\"","type":"codeVoice"},{"type":"text","text":")."}]}],"name":"library"},{"content":[{"inlineContent":[{"text":"Maximum time (in seconds) to wait for ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":". Defaults to 0.1s.","type":"text"}],"type":"paragraph"}],"name":"timeoutSeconds"}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","isActive":true},{"type":"text","text":" indicating the detection status:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".clean(loadTime:library:)","type":"codeVoice"},{"text":": No injection detected","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"type":"text","text":": Suspicious delay during load attempt (possible hooking)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,","type":"text"},{"text":" ","type":"text"},{"text":"and provides detailed detection results for security logging.","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"Uses ","type":"text"},{"code":"RTLD_NOLOAD","type":"codeVoice"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"text":" ","type":"text"},{"text":"Requires ","type":"text"},{"code":"import Darwin","type":"codeVoice"},{"text":". Modern jailbreaks may hook ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" to evade detection.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"inlineContent":[{"type":"text","text":"Usage example:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"content":[{"inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)"]}],"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/