","text":"Name of the dynamic library to check (e.g., "},{"type":"codeVoice","code":"\"MobileSubstrate.dylib\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"libhooker.dylib\""},{"text":").","type":"text"}],"type":"paragraph"}]},{"name":"timeoutSeconds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum time (in seconds) to wait for "},{"code":"dlopen","type":"codeVoice"},{"text":". Defaults to 0.1s.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","level":2,"anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","isActive":true},{"text":" indicating the detection status:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".clean(loadTime:library:)"},{"type":"text","text":": No injection detected"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"text":": Suspicious delay during load attempt (possible hooking)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}],"type":"paragraph"}]}],"type":"unorderedList"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"text":" ","type":"text"},{"text":"Requires ","type":"text"},{"code":"import Darwin","type":"codeVoice"},{"text":". Modern jailbreaks may hook ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":" to evade detection.","type":"text"}]}],"type":"aside","name":"Note","style":"note"},{"inlineContent":[{"type":"text","text":"Usage example:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"],"type":"codeListing"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection.","type":"text"}]}],"type":"aside"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"kind":"symbol","abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldi