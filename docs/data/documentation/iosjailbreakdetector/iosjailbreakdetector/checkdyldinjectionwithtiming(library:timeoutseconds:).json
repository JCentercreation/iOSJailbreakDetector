ype":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}]}]}],"type":"unorderedList"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}]},{"content":[{"inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"text":" flag to check if library is already loaded without forcing a new load.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"code":"dlopen","type":"codeVoice"},{"type":"text","text":" to evade detection."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"inlineContent":[{"text":"Usage example:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"aside","co