{"metadata":{"externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","roleHeading":"Instance Method","modules":[{"name":"iOSJailbreakDetector"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","text":"DYLDInjectionResult","kind":"typeIdentifier"}],"symbolKind":"method","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds:)"]}],"identifier":{"url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector\/checkDYLDInjectionWithTiming(library:timeoutSeconds:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process."}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sd","text":"Double","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","text":"DYLDInjectionResult","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"library","content":[{"type":"paragraph","inlineContent":[{"text":"Name of the dynamic library to check (e.g., ","type":"text"},{"code":"\"MobileSubstrate.dylib\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"libhooker.dylib\"","type":"codeVoice"},{"text":").","type":"text"}]}]},{"name":"timeoutSeconds","content":[{"type":"paragraph","inlineContent":[{"text":"Maximum time (in seconds) to wait for ","type":"text"},{"code":"dlopen","type":"codeVoice"},{"text":". Defaults to 0.1s.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","isActive":true},{"type":"text","text":" indicating the detection status:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".clean(loadTime:library:)"},{"text":": No injection detected","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"type":"text","text":": Suspicious delay during load attempt (possible hooking)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}],"type":"paragraph"}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"type":"text","text":" flag to check if library is already loaded without forcing a new load."},{"type":"text","text":" "},{"type":"text","text":"Requires "},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" to evade detection."}],"type":"paragraph"}],"name":"Note","type":"aside","style":"note"},{"inlineContent":[{"type":"text","text":"Usage example:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"]},{"content":[{"inlineContent":[{"type":"text","text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection."}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"}]}],"sections":[],"references":{"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector":{"url":"\/documentation\/iosjailbreakdetector","abstract":[],"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","role":"collection","title":"iOSJailbreakDetector","type":"topic","kind":"symbol"},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector":{"type":"topic","url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"iOSJailbreakDetector","kind":"identifier"}],"title":"iOSJailbreakDetector","role":"symbol","navigatorTitle":[{"text":"iOSJailbreakDetector","kind":"identifier"}],"abstract":[]},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/DYLDInjectionResult":{"role":"symbol","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"text":"DYLDInjectionResult","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Detailed result from DYLD injection detection with timing analysis."}],"title":"DYLDInjectionResult","navigatorTitle":[{"text":"DYLDInjectionResult","kind":"identifier"}],"url":"\/documentation\/iosjailbreakdetector\/dyldinjectionresult"},"doc://iOSJailbreakDetector/documentation/iOSJailbreakDetector/iOSJailbreakDetector/checkDYLDInjectionWithTiming(library:timeoutSeconds:)":{"url":"\/documentation\/iosjailbreakdetector\/iosjailbreakdetector\/checkdyldinjectionwithtiming(library:timeoutseconds: