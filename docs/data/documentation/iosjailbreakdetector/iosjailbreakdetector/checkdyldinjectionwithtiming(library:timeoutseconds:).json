{"abstract":[{"text":"Detects DYLD injection by checking if a suspicious dynamic library is loadable in the current process.","type":"text"}],"metadata":{"title":"checkDYLDInjectionWithTiming(library:timeoutSeconds:)","role":"symbol","externalID":"s:20iOSJailbreakDetectorAAC28checkDYLDInjectionWithTiming7library14timeoutSecondsAA0D6ResultOSS_SdtF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","kind":"typeIdentifier"}],"modules":[{"name":"iOSJailbreakDetector"}],"symbolKind":"method","roleHeading":"Instance Method"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"checkDYLDInjectionWithTiming","kind":"identifier"},{"text":"(","kind":"text"},{"text":"library","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"timeoutSeconds","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","preciseIdentifier":"s:Sd","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"DYLDInjectionResult","preciseIdentifier":"s:20iOSJailbreakDetector19DYLDInjectionResultO","identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult","kind":"typeIdentifier"}]}]},{"parameters":[{"name":"library","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Name of the dynamic library to check (e.g., "},{"type":"codeVoice","code":"\"MobileSubstrate.dylib\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"libhooker.dylib\""},{"type":"text","text":")."}]}]},{"name":"timeoutSeconds","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum time (in seconds) to wait for "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":". Defaults to 0.1s."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/DYLDInjectionResult"},{"text":" indicating the detection status:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".clean(loadTime:library:)"},{"type":"text","text":": No injection detected"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".suspicious(delay:library:)"},{"type":"text","text":": Suspicious delay during load attempt (possible hooking)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".injected(handle:loadTime:library:)"},{"type":"text","text":": Confirmed injection - library successfully loaded"}]}]}]}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Enhanced version that measures load time to detect hooking delays, validates the library handle,"},{"type":"text","text":" "},{"type":"text","text":"and provides detailed detection results for security logging."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Uses "},{"type":"codeVoice","code":"RTLD_NOLOAD"},{"type":"text","text":" flag to check if library is already loaded without forcing a new load."},{"text":" ","type":"text"},{"text":"Requires ","type":"text"},{"type":"codeVoice","code":"import Darwin"},{"type":"text","text":". Modern jailbreaks may hook "},{"type":"codeVoice","code":"dlopen"},{"type":"text","text":" to evade detection."}]}],"name":"Note","style":"note"},{"type":"paragraph","inlineContent":[{"text":"Usage example:","type":"text"}]},{"type":"codeListing","code":["\/\/ Check common jailbreak libraries","let libraries = [\"MobileSubstrate.dylib\", \"libhooker.dylib\", \"SSLKillSwitch2.dylib\"]","","for library in libraries {","    let result = checkDYLDInjectionWithTiming(library: library, timeoutSeconds: 0.1)","","    switch result {","    case .clean(let time, _):","        Logger.security.debug(\"Clean: $$library) checked in $$time*1000, specifier: \"%.1f\")ms\")","    case .suspicious(let delay, _):","        Logger.security.warning(\"Suspicious DYLD delay: $$library) took $$delay*1000, specifier: \"%.1f\")ms\")","    case .injected(_, let time, _):","        Logger.security.error(\"DYLD INJECTION DETECTED: $$library) loaded in $$time*1000, specifier: \"%.1f\")ms\")","        return result \/\/ Early exit on confirmed injection","    }","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Part of layered jailbreak detection. Combine with file checks and sandbox tests for comprehensive protection.","type":"text"}]}],"style":"important","name":"Important"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector","doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJailbreakDetector"]]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/iOSJailbreakDetector\/documentation\/iOSJailbreakDetector\/iOSJa